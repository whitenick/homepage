{
  "name": "@serapiolabs/design-system",
  "version": "0.1.0",
  "private": false,
  "description": "Serapio Labs Design System — Base UI + Tailwind + CSS custom properties. Build once, theme infinitely.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/tokens.css",
  "files": [
    "dist/**",
    "tailwind.plugin.js",
    "tokens.css"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --external react --external react-dom",
    "dev": "tsup src/index.tsx --format cjs,esm --dts --external react --external react-dom --watch",
    "build:tokens": "node scripts/build-tokens.mjs",
    "prepublishOnly": "npm run build && npm run build:tokens",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.480.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
