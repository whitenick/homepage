{
  "name": "homepage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run generate-supabase & next dev & npm run styles",
    "generate-supabase": "npx supabase gen types typescript --project-id 'sglefycqqmirdvbpajie' --schema public > types/supabase.ts",
    "build": "npm i && npx tailwindcss -i ./pages/index.css -o ./pages/tw.css && next build",
    "start": "next start",
    "start:prod": "next build && NODE_ENV=production next start",
    "styles": "npx tailwindcss -i ./pages/index.css -o ./pages/tw.css --watch",
    "lint": "eslint .",
    "export": "next export"
  },
  "dependencies": {
